# Copy to .env.local. With the mock on, the site runs fully in the browser with no backend.
NEXT_PUBLIC_API_MOCK=1

# Used when the mock is off. Include /api/v1.
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Local backend only, with DEV_FAKE_PROVIDERS on. Pay finishes through its fake gateway.
# Set the secret to the backend's CRON_SECRET. It stays on the server.
NEXT_PUBLIC_DEV_CAPTURE=0
DEV_CAPTURE_SECRET=
