# For local work. A server sets NODE_ENV=production itself, and refuses DEV_FAKE_PROVIDERS.
NODE_ENV=development
# true runs the fake gateway and file store, so local work needs no keys. See Local development in the README.
DEV_FAKE_PROVIDERS=true

# Required everywhere.
DATABASE_URL=postgres://lastbite:lastbite@localhost:5433/lastbite
TEST_DATABASE_URL=postgres://lastbite:lastbite@localhost:5433/lastbite_test
FRONTEND_ORIGIN=http://localhost:3000
BRAND_NAME=LastBite
# Leave empty on localhost. In production, the shared parent domain.
COOKIE_DOMAIN=localhost
ENCRYPTION_KEY=replace-with-32-random-bytes-base64
SESSION_SECRET=replace-with-a-long-random-string
PORT=4000
# true only behind a proxy that sets x-forwarded-for. Otherwise the socket address is used.
TRUST_PROXY=false

# Everything below is required when NODE_ENV=production, and the server will not start without it.

# Sent by the cron service in the x-cron-secret header. With none set the tick route refuses every call.
# The local dev capture route takes it too, so set any value to use that.
CRON_SECRET=

RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
# A domain you control. Each linked account gets a unique address on it, as linked+<ref>.<random>@this-domain.
RAZORPAY_LINKED_EMAIL_DOMAIN=

# The WhatsApp and SMS provider, or a relay in front of it.
MESSAGING_API_URL=
MESSAGING_API_KEY=
MESSAGING_WEBHOOK_SECRET=
# Optional: the header that carries the provider's webhook signature.
MESSAGING_WEBHOOK_SIGNATURE_HEADER=x-webhook-signature

AWS_REGION=ap-south-1
S3_PUBLIC_BUCKET=
S3_PRIVATE_BUCKET=
# Optional: a CDN or custom domain for the public bucket.
S3_PUBLIC_BASE_URL=
# AWS credentials are found by the SDK: a role on the host, or these.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
