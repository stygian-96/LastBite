# Copy to .env next to compose.yaml, fill in, and keep it off git. chmod 600 .env
# Compose reads it, and the API gets all of it.

# --- Site ---
WEB_DOMAIN=www.example.com
API_DOMAIN=api.example.com
# The shared parent of the two, for the sign-in cookie.
COOKIE_DOMAIN=example.com
BRAND_NAME=LastBite

# --- Secrets: make each with  openssl rand -base64 32  and save them in a password manager ---
DB_PASSWORD=
# Losing this makes every saved bank account unreadable.
ENCRYPTION_KEY=
SESSION_SECRET=
CRON_SECRET=

# --- Staging, until Razorpay and SMS are connected ---
# Fake payments, fake file store, and sign-in codes printed in the API log:
#   docker compose logs api | grep -i code
NODE_ENV=development
DEV_FAKE_PROVIDERS=true
# 1 lets Pay finish without paying. Rebuild the site after changing it: docker compose up -d --build web
TEST_PAYMENTS=1

# --- Production: delete the three lines above, set NODE_ENV=production, and fill in all of these ---
# RAZORPAY_KEY_ID=
# RAZORPAY_KEY_SECRET=
# RAZORPAY_WEBHOOK_SECRET=
# RAZORPAY_LINKED_EMAIL_DOMAIN=
# MESSAGING_API_URL=
# MESSAGING_API_KEY=
# MESSAGING_WEBHOOK_SECRET=
# AWS_REGION=ap-south-1
# S3_PUBLIC_BUCKET=
# S3_PRIVATE_BUCKET=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
